            "body": {
              "mode": "raw",
              "raw": "{\n  \"city\": \"{{cityId}}\",\n  \"district\": \"{{districtId}}\",\n  \"about\": \"Profil de test créé depuis Postman.\",\n  \"phoneNumber\": {\n    \"countryCode\": \"+237\",\n    \"number\": \"670000000\"\n  },\n  \"profileImageId\": \"{{profileImageId}}\"\n}",
              "options": {
                "raw": {
