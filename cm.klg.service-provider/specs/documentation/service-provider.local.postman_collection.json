  "item": [
    {
      "name": "Mon profil prestataire",
      "item": [
        {
          "name": "Become Service Provider [POST /service-provider]",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/service-provider",
            "description": "Become Service Provider\n\nAuthentification requise : Bearer {{userToken}}.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"city\": \"{{cityId}}\",\n  \"district\": \"{{districtId}}\",\n  \"quarter\": \"{{quarterId}}\",\n  \"about\": \"Profil de test créé depuis Postman.\",\n  \"phoneNumber\": {\n    \"countryCode\": \"+237\",\n    \"number\": \"670000000\"\n  },\n  \"serviceType\": {\n    \"id\": \"{{mediaId}}\",\n    \"yearOfExperience\": 4,\n    \"document\": \"{{documentMediaId}}\"\n  },\n  \"cniRectoId\": \"{{cniRectoId}}\",\n  \"cniVersoId\": \"{{cniVersoId}}\",\n  \"profileImageId\": \"{{profileImageId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const accepted = [201];",
                  "pm.test(\"Réponse HTTP attendue\", function () { pm.expect(accepted).to.include(pm.response.code); });",
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  if (body.newId) pm.environment.set(\"serviceProviderId\", body.newId);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get my service provider application [GET /me/service-provider]",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/me/service-provider",
            "description": "Get my service provider application\n\nAuthentification requise : Bearer {{userToken}}.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const accepted = [200];",
                  "pm.test(\"Réponse HTTP attendue\", function () { pm.expect(accepted).to.include(pm.response.code); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get my rejected identity documents [GET /me/service-provider/identity]",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/me/service-provider/identity",
            "description": "Retourne les références CNI recto/verso, la photo de profil et le motif de rejet uniquement lorsque la vérification d'identité est REJECTED. Réponse 409 si elle ne l'est pas.\n\nAuthentification requise : userToken du prestataire concerné.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const accepted = [200, 409];",
                  "pm.test(\"Réponse HTTP attendue\", function () { pm.expect(accepted).to.include(pm.response.code); });",
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.test(\"Identité retournée uniquement au statut REJECTED\", function () { pm.expect(body.status).to.eql(\"REJECTED\"); });",
                  "  pm.test(\"Références et motif présents\", function () { pm.expect(body).to.include.keys(\"providerId\", \"cniRectoId\", \"cniVersoId\", \"profileImageId\", \"status\", \"rejectionReason\"); });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Resubmit a rejected service provider application [PUT /me/service-provider]",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/me/service-provider",
            "description": "Updates the rejected provider profile and identity documents, then returns the same ServiceProvider and IdentityVerification to PENDING. User account details remain managed by UAM.\n\nAuthentification requise : Bearer {{userToken}}.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"city\": \"{{cityId}}\",\n  \"district\": \"{{districtId}}\",\n  \"about\": \"Profil de test créé depuis Postman.\",\n  \"phoneNumber\": {\n    \"countryCode\": \"+237\",\n    \"number\": \"670000000\"\n  },\n  \"cniRectoId\": \"{{cniRectoId}}\",\n  \"cniVersoId\": \"{{cniVersoId}}\",\n  \"profileImageId\": \"{{profileImageId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const accepted = [204];",
                  "pm.test(\"Réponse HTTP attendue\", function () { pm.expect(accepted).to.include(pm.response.code); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Update an approved service provider profile [PUT /me/service-provider/profile]",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/me/service-provider/profile",
            "description": "Updates approved profile fields without changing IdentityVerification. A changed profile photo remains pending admin review. User identity information is managed separately by UAM.\n\nAuthentification requise : Bearer {{userToken}}.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
