          ]
        },
        {
          "name": "Rejeter la photo [PUT /service-provider/{serviceProviderId}/profile-image/reject]",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/service-provider/{{serviceProviderId}}/profile-image/reject",
            "description": "Rejette la photo en attente. La photo publique actuelle reste active. La raison doit être une valeur de l’énumération RejectionReason.\n\nAuthentification requise : Bearer {{adminRejectToken}} (scope service-provider:reject).",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminRejectToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "\"{{profileImageRejectionReason}}\"",
              "options": {
