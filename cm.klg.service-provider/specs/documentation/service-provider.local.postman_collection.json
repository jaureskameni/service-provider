        {
          "name": "Approuver la photo [PUT /service-provider/{serviceProviderId}/profile-image/approve]",
          "request": {
            "method": "PUT",
            "header": [],
            "url": "{{baseUrl}}/service-provider/{{serviceProviderId}}/profile-image/approve",
            "description": "Approuve la photo en attente; elle devient la photo publique du prestataire.\n\nAuthentification requise : Bearer {{adminApproveToken}} (scope service-provider:approve).",
            "auth": {
              "type": "bearer",
