    {
      "name": "Admin · candidatures",
      "item": [
        {
          "name": "Get service provider verification details [GET /service-provider/{serviceProviderId}/verification]",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/service-provider/{{serviceProviderId}}/verification",
            "description": "Retourne les informations du prestataire, ses services, son portfolio et les données privées de vérification. Pour un prestataire APPROVED, identityVerification est omis.\n\nAuthentification requise : ****** (scope service-provider:verify).",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminVerifyToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Réponse HTTP attendue\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.test(\"Identité absente si prestataire APPROVED\", function () {",
                  "    if (body.status === \"APPROVED\") pm.expect(body).not.to.have.property(\"identityVerification\");",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
